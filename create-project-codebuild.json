{
    "name": "rag-system-deployment",
    "description": "Main build project to deploy RAG infrastructure via Terraform",
    "serviceRole": "arn:aws:iam::054375299743:role/rag-project-codebuild-role",
    "artifacts": {
        "type": "NO_ARTIFACTS"
    },
    "environment": {
        "type": "LINUX_CONTAINER",
        "image": "aws/codebuild/standard:7.0",
        "computeType": "BUILD_GENERAL1_SMALL",
        "environmentVariables": [
            {
                "name": "PROJECT_NAME",
                "value": "RAG-AWS-Project",
                "type": "PLAINTEXT"
            }
        ]
    },
    "source": {
        "type": "GITHUB",
        "location": "https://github.com/Reasy94/RAGAWS",
        "gitCloneDepth": 1
    }
}